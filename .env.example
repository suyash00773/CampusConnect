# CampusConnect - Global Environment Setup Example

# Server Environment Variables (in server/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
JWT_SECRET=campusconnect_super_secret_jwt_key_2026_dev_prod
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Client Environment Variables (in client/.env if overriding dev proxy)
VITE_API_URL=/api
